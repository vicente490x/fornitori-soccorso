FROM eclipse-temurin:25-jdk AS build
WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw
COPY src src
COPY api api
RUN ./mvnw --batch-mode --no-transfer-progress -Pvercel-demo clean package

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app/target/fornitori-0.0.1-SNAPSHOT.jar app.jar
ENV SERVER_ADDRESS=0.0.0.0 SERVER_PORT=8080 PORT=8080
EXPOSE 8080
USER 10001
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=65", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/app.jar"]
